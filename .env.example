# Postgres connection string. Leave empty in development to use the embedded
# PGlite database stored in ./.data (no Docker or Postgres install needed).
DATABASE_URL=

# API port in development (production uses PORT).
API_PORT=3000
# Public URL of the app, used for invite links and to validate the Origin header.
APP_URL=http://localhost:5173

# Payment provider: "mock" (dev simulator) or "paystack".
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=

# Optional: enables AI-written credit narratives and outreach drafts.
# Without it, Fundly uses deterministic templates.
ANTHROPIC_API_KEY=

# Comma-separated emails that get platform-admin access on signup/login.
PLATFORM_ADMIN_EMAILS=

# Transactional email (organiser links for the free merry-go-round tool).
#   dev    — nothing is sent; read messages at http://localhost:3000/api/dev/outbox (also saved to .data/outbox)
#   resend — https://resend.com, set RESEND_API_KEY
#   smtp   — any SMTP server, e.g. SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_PROVIDER=dev
EMAIL_FROM="Fundly <hello@your-domain.com>"
RESEND_API_KEY=
SMTP_URL=
